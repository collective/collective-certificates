{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@plone/volto/*": ["../../core/packages/volto/src/*"],
      "@plone-collective/volto-certificates/*": ["./src/*"],
      "react-router-dom": [
        "../../core/packages/volto/node_modules/@types/react-router-dom"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../core/packages/volto/types/react-router-hash-link.d.ts"
  ],
  "exclude": ["node_modules", "build", "public", "coverage"]
}
