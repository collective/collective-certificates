    {"content": "{{ event_end_date|date }}", "date_format": "%Y-%m-%d", "expected": "2026-12-31", "tokens": ["event_end_date"]},
    {"content": "{{ event_end_date|date }}", "date_format": "%d%% %B", "expected": "31% December", "tokens": ["event_end_date"]},
    {"content": "{{ event_start_date }}", "expected": "2026-05-06", "tokens": ["event_start_date"]},
    {"content": "from {{ event_start_date|date }} to {{ event_end_date|date }}, {{ total_hours }} hours.", "expected": "from 06/05/2026 to 31/12/2026, 32 hours.", "tokens": ["event_start_date", "event_end_date", "total_hours"]},
    {"content": "{{ full_name }} {{ full_name }}", "expected": "William Riker William Riker", "tokens": ["full_name"]},
